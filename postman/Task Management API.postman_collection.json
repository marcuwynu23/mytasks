{
  "info": {
    "name": "Task Management API",
    "description": "API collection for the Task Management System. Authentication is cookie-based — login/register automatically sets the `token` cookie for subsequent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "apiPath",
      "value": "/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"middleName\": \"\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "auth", "login"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "auth", "logout"]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "auth", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Smith\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "auth", "profile"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password1!\",\n  \"newPassword\": \"NewPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/auth/password",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "auth", "password"]
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Get All Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "tasks"]
            }
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My New Task\",\n  \"description\": \"This is a sample task\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "tasks"]
            }
          }
        },
        {
          "name": "Get Task by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/tasks/:id",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "tasks", ":id"],
              "variable": [
                { "key": "id", "value": "TASK_ID_HERE" }
              ]
            }
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"description\": \"Updated description\",\n  \"status\": \"completed\",\n  \"dueDate\": \"2026-07-15T12:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/tasks/:id",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "tasks", ":id"],
              "variable": [
                { "key": "id", "value": "TASK_ID_HERE" }
              ]
            }
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/tasks/:id",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "tasks", ":id"],
              "variable": [
                { "key": "id", "value": "TASK_ID_HERE" }
              ]
            }
          }
        }
      ]
    }
  ]
}
